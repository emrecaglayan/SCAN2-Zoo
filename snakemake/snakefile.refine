# vim: syntax=python

rule refine_passes:
    input:
        config_file = config["config_path"],
        scan2_fn = lambda wildcards: config["scan2_objects"][wildcards.sample]
    output:
        "objects/{sample}_scan2_object_refine.rds"
    resources:
	# Most objects use <10GB but better to request 15GB just in case
        mem=15000
    shell:
        """
        {config[scripts]}/refine_passes.R {input.config_file} {input.scan2_fn}
        """

